#include <stdio.h>

int max_number = 100;
int max_on_line = 10;
int number_counter = 1;

int main() {
    
    for (; number_counter <= max_number; number_counter++) {
        printf("%d ", number_counter);
        
        if (number_counter % max_on_line == 0) {
            printf("\n");
            
        }
    }
}
